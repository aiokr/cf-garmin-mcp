{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-garmin-mcp",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-11-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "vars": {
    "APP_URL": "http://localhost:8787",
    "GARMIN_AUTH_MODE": "credentials",
    "GARMIN_REGION": "CN",
    "PROVIDER_KEY_VERSION": "1",
    "MAX_FIT_BYTES": "16777216",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cf-garmin-mcp",
      // Local placeholder. Deploy button / prepare-deploy resolves the real UUID before migrations.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "apps/worker/migrations",
    },
  ],
  "r2_buckets": [
    // Provisioned automatically for button deployments; keep public access disabled.
    { "binding": "FIT_BUCKET", "bucket_name": "cf-garmin-mcp-fit" },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "INSTANCE_GUARD", "class_name": "InstanceGuard" },
      { "name": "GARMIN_AUTH", "class_name": "GarminAuth" },
      { "name": "OAUTH_COORDINATOR", "class_name": "OAuthCoordinator" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["InstanceGuard"] },
    { "tag": "v2", "new_sqlite_classes": ["GarminAuth", "OAuthCoordinator"] },
  ],
  "workflows": [
    {
      "binding": "SYNC_WORKFLOW",
      "name": "cf-garmin-sync",
      "class_name": "SyncWorkflow",
    },
  ],
  "triggers": {
    "crons": ["*/30 * * * *", "5 * * * *", "15 2 * * *", "30 2 * * SUN"],
  },
  "observability": { "enabled": false },
}
